# PagerDuty API Configuration
# Get your API key from: https://support.pagerduty.com/docs/api-access-keys
PAGERDUTY_API_KEY=your_api_key_here

# Optional: Comma-separated list of team IDs to monitor
# Can also be specified via --team CLI argument
PAGERDUTY_TEAM_IDS=TEAM1,TEAM2,TEAM3

# Optional: Maximum number of on-call days allowed per month
# Default: 10
ONCALL_MAX_DAYS=10

# Optional: Default timezone for calculations
# Default: UTC
TIMEZONE=UTC

# Optional: JSON mapping of user emails to timezones for timezone-aware calculations
# Only counts days where on-call extends past workday end hour
# Example: USER_TIMEZONES='{"user1@example.com": "America/New_York", "user2@example.com": "Europe/London"}'
USER_TIMEZONES={}

# Optional: Hour (0-23) when the standard workday ends
# Only on-call shifts that extend past this hour will be counted
# Default: 17 (5 PM)
WORKDAY_END_HOUR=17

# Optional: Comma-separated list of timezones to include in analysis
# If not specified, all timezones are included
# Can also be specified via --timezone CLI argument
# Example: TIMEZONES_OF_CONCERN=America/New_York,Europe/London,America/Los_Angeles
TIMEZONES_OF_CONCERN=

# Optional: Comma-separated list of user emails to exclude from over-limit reporting
# These users will not appear in the analysis results even if they exceed the day limit
# Can also be specified via --exclude-user CLI argument
# Example: EXCLUDED_USERS=user1@example.com,user2@example.com
EXCLUDED_USERS=

# Optional: Sentry DSN for error tracking
# Get your DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Sentry environment name
# Default: production
SENTRY_ENVIRONMENT=production
