# PagerDuty API Configuration
# Get your API key from: https://support.pagerduty.com/docs/api-access-keys
PAGERDUTY_API_KEY=your_api_key_here

# Optional: Comma-separated list of team IDs to monitor
# Can also be specified via --team CLI argument
PAGERDUTY_TEAM_IDS=TEAM1,TEAM2,TEAM3

# Optional: Maximum number of on-call days allowed per month
# Default: 10
ONCALL_MAX_DAYS=10

# Optional: Sentry DSN for error tracking
# Get your DSN from: https://sentry.io/settings/projects/
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Optional: Sentry environment name
# Default: production
SENTRY_ENVIRONMENT=production
